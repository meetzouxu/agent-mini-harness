# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 排除，不会进入版本库）
# DeepSeek 开放平台 https://platform.deepseek.com 创建 API Key

# 必填：DeepSeek API Key
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 可选：API 地址（默认官方地址；如走代理/中转可修改）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选：模型名（deepseek-chat / deepseek-reasoner）
MINI_AGENT_MODEL=deepseek-chat

# 可选：Agent Loop 最大轮次（防止死循环）
MINI_AGENT_MAX_TURNS=15
